# ---------------------------------------------------------------------------
# Actora — public build-time variables
# Copy to `.env` (local) or set in GitHub Actions repository variables.
# Nothing in this file may contain a real secret: every VITE_* value is
# embedded in the public JavaScript bundle.
# ---------------------------------------------------------------------------

# Canonical origin used for canonicals, sitemap, RSS and OG tags.
# No trailing slash. Example: https://actorallc.com
VITE_SITE_URL=https://actorallc.example

# Base path. Use "/" for a custom domain or "/<repository-name>/" for a
# GitHub Pages project site.
VITE_BASE_PATH=/

# Public URL of the deployed inquiry API (Cloudflare Worker or equivalent).
# Leave empty to keep forms in a clearly labelled "not configured" state.
# Never place email provider keys here — they belong in the server runtime.
VITE_INQUIRY_ENDPOINT=

# Public base URL for the contract status API (same Worker by default).
VITE_CONTRACT_API_ENDPOINT=
